# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
REVIEW_MODEL=claude-sonnet-5-5
# USD per million tokens "input,output" for cost reporting; check https://docs.claude.com for current prices
REVIEW_PRICE_PER_MTOK=

# GitHub: fine-grained token with Pull requests (read/write) and Contents (read) on the target repos
GITHUB_TOKEN=

# Webhook server only
GITHUB_WEBHOOK_SECRET=
ADMIN_TOKEN=
REVIEW_DB=/data/reviews.sqlite
